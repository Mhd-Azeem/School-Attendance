# Web/PWA — use the public anon key only. Never expose the service-role key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_SCHOOL_TIMEZONE=Asia/Colombo

# Android: copy these values to android/local.properties (not committed)
